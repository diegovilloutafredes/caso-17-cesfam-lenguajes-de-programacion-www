<mxfile host="app.diagrams.net">
  <diagram id="case17-ms" name="Caso 17 - Vista de Microservicios">
    <mxGraphModel dx="1565" dy="1020" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1850" pageHeight="1850" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;" value="Caso 17 — CESFAM&lt;br&gt;Vista de Microservicios — Contratos &amp;amp; Clientes Inter-Servicio" vertex="1">
          <mxGeometry height="60" width="1000" x="425" y="10" as="geometry" />
        </mxCell>
        <mxCell id="notaProposito" parent="1" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=top;align=left;fontSize=11;spacingTop=8;spacingLeft=14;spacingRight=22;spacingBottom=8;shadow=1;" value="&lt;b&gt;Propósito del diagrama&lt;/b&gt;&lt;hr style=&quot;margin:6px 0;border:0;border-top:1px solid #d6b656;&quot;/&gt;&lt;div style=&quot;text-align:left;&quot;&gt;Capa de &lt;b&gt;contratos inter-servicio&lt;/b&gt;. Complementa al diagrama de dominio (Caso17_DiagramaClases.drawio) — no lo reemplaza.&lt;br/&gt;&lt;br/&gt;Cada &lt;b&gt;«service»&lt;/b&gt; expone un contrato HTTP. Todos los métodos públicos retornan &lt;i&gt;ApiResponse&amp;lt;T&amp;gt;&lt;/i&gt; — el envelope estándar de transporte.&lt;br/&gt;&lt;br/&gt;Los &lt;b&gt;«client»&lt;/b&gt; son adaptadores que un servicio (o el gateway) usa para llamar a otro servicio: encapsulan baseUrl, retry, circuit breaker y traducen HTTP ↔ tipo de dominio.&lt;br/&gt;&lt;br/&gt;El dominio interno de cada servicio (Patient, Prescription, Batch, ...) vive en el otro diagrama.&lt;/div&gt;" vertex="1">
          <mxGeometry height="200" width="540" x="40" y="90" as="geometry" />
        </mxCell>
        <mxCell id="apiResponse" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#333333;verticalAlign=top;align=center;fontSize=11;spacingTop=6;spacingLeft=6;spacingRight=6;spacingBottom=6;" value="&lt;i&gt;«envelope»&lt;/i&gt;&lt;br/&gt;&lt;b&gt;ApiResponse&amp;lt;T&amp;gt;&lt;/b&gt;&lt;hr style=&quot;margin:4px 0;border:0;border-top:1px solid #333333;&quot;/&gt;&lt;div style=&quot;text-align:left;&quot;&gt;- statusCode: Integer&lt;br/&gt;- data: T [0..1]&lt;br/&gt;- error: ErrorDetail [0..1]&lt;br/&gt;- traceId: String&lt;br/&gt;- timestamp: DateTime&lt;/div&gt;&lt;hr style=&quot;margin:4px 0;border:0;border-top:1px solid #333333;&quot;/&gt;&lt;div style=&quot;text-align:left;&quot;&gt;+ isSuccess(): Boolean&lt;br/&gt;+ unwrap(): T&lt;/div&gt;" vertex="1">
          <mxGeometry height="180" width="280" x="620" y="90" as="geometry" />
        </mxCell>
        <mxCell id="errorDetail" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#333333;verticalAlign=top;align=center;fontSize=11;spacingTop=6;spacingLeft=6;spacingRight=6;spacingBottom=6;" value="&lt;i&gt;«envelope»&lt;/i&gt;&lt;br/&gt;&lt;b&gt;ErrorDetail&lt;/b&gt;&lt;hr style=&quot;margin:4px 0;border:0;border-top:1px solid #333333;&quot;/&gt;&lt;div style=&quot;text-align:left;&quot;&gt;- code: String&lt;br/&gt;- message: String&lt;br/&gt;- details: Map&amp;lt;String, Any&amp;gt; [0..1]&lt;/div&gt;&lt;hr style=&quot;margin:4px 0;border:0;border-top:1px solid #333333;&quot;/&gt;&lt;div style=&quot;text-align:left;&quot;&gt;&lt;b&gt;Ejemplos de code:&lt;/b&gt;&lt;br/&gt;NOT_FOUND, INVALID_STATE,&lt;br/&gt;INSUFFICIENT_STOCK, UNAUTHORIZED&lt;/div&gt;" vertex="1">
          <mxGeometry height="180" width="280" x="920" y="90" as="geometry" />
        </mxCell>
        <mxCell id="estereotiposLegend" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;align=left;fontSize=10;spacingTop=8;spacingLeft=12;spacingRight=12;spacingBottom=8;dashed=1;" value="&lt;div style=&quot;text-align:center;&quot;&gt;&lt;b&gt;Estereotipos y notación&lt;/b&gt;&lt;/div&gt;&lt;hr style=&quot;margin: 6px 0px; border-width: 1px 0px 0px; border-style: solid none none; border-color: rgb(102, 102, 102) currentcolor currentcolor; border-image: initial;&quot;&gt;&lt;b&gt;«envelope»&lt;/b&gt; — tipo de transporte (no dominio).&lt;br&gt;&lt;b&gt;«service»&lt;/b&gt; — microservicio con contrato HTTP.&lt;br&gt;&lt;b&gt;«client»&lt;/b&gt; — adaptador HTTP que llama a un «service».&lt;br&gt;&lt;b&gt;«gateway»&lt;/b&gt; — Backend-for-Frontend (BFF) que agrega.&lt;br&gt;&lt;br&gt;&lt;b&gt;Flechas:&lt;/b&gt;&lt;br&gt;◆── composición : «service» o «gateway» contiene «client».&lt;br&gt;- - ▷ «HTTPS» : «client» llama a su «service» vía REST.&lt;br&gt;&lt;br&gt;&lt;b&gt;Convenciones:&lt;/b&gt;&lt;br&gt;• Todos los métodos públicos retornan &lt;i&gt;ApiResponse&amp;lt;T&amp;gt;&lt;/i&gt;.&lt;br&gt;• &lt;b&gt;Auth transversal:&lt;/b&gt; todos los «service» validan token vía&lt;br&gt;&amp;nbsp;&amp;nbsp;IdentityService.validateToken() — flechas omitidas&lt;br&gt;&amp;nbsp;&amp;nbsp;para no saturar." vertex="1">
          <mxGeometry height="220" width="310" x="1240" y="90" as="geometry" />
        </mxCell>
        <mxCell id="patientService" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;align=center;fontSize=11;spacingTop=6;spacingLeft=6;spacingRight=6;spacingBottom=6;" value="&lt;i&gt;«service»&lt;/i&gt;&lt;br/&gt;&lt;b&gt;PatientService&lt;/b&gt;&lt;hr style=&quot;margin:4px 0;border:0;border-top:1px solid #82b366;&quot;/&gt;&lt;div style=&quot;text-align:left;&quot;&gt;+ getPatient(id): ApiResponse&amp;lt;Patient&amp;gt;&lt;br/&gt;+ listPatients(filter): ApiResponse&amp;lt;Page&amp;lt;Patient&amp;gt;&amp;gt;&lt;br/&gt;+ updatePatient(id, body): ApiResponse&amp;lt;Patient&amp;gt;&lt;br/&gt;+ getHistory(id): ApiResponse&amp;lt;PatientHistory&amp;gt;&lt;br/&gt;+ addGuardian(patientId, body): ApiResponse&amp;lt;Guardian&amp;gt;&lt;br/&gt;+ listGuardians(patientId): ApiResponse&amp;lt;List&amp;lt;Guardian&amp;gt;&amp;gt;&lt;br/&gt;+ removeGuardian(patientId, gId): ApiResponse&amp;lt;Void&amp;gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="170" width="380" x="40" y="480" as="geometry" />
        </mxCell>
        <mxCell id="inventoryService" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8d4b5;strokeColor=#a86c1c;verticalAlign=top;align=center;fontSize=11;spacingTop=6;spacingLeft=6;spacingRight=6;spacingBottom=6;" value="&lt;i&gt;«service»&lt;/i&gt;&lt;br/&gt;&lt;b&gt;InventoryService&lt;/b&gt;&lt;hr style=&quot;margin:4px 0;border:0;border-top:1px solid #a86c1c;&quot;/&gt;&lt;div style=&quot;text-align:left;&quot;&gt;+ listMedications(filter): ApiResponse&amp;lt;Page&amp;lt;Medication&amp;gt;&amp;gt;&lt;br/&gt;+ getMedication(id): ApiResponse&amp;lt;MedicationDetail&amp;gt;&lt;br/&gt;+ getStockSummary(): ApiResponse&amp;lt;StockSummary&amp;gt;&lt;br/&gt;+ addBatch(medId, body): ApiResponse&amp;lt;Batch&amp;gt;&lt;br/&gt;+ writeOffBatch(batchId, body): ApiResponse&amp;lt;Batch&amp;gt;&lt;br/&gt;+ listWriteOffs(filter): ApiResponse&amp;lt;Page&amp;lt;WriteOff&amp;gt;&amp;gt;&lt;br/&gt;+ getWriteOff(id): ApiResponse&amp;lt;WriteOff&amp;gt;&lt;br/&gt;+ reserveStock(medId, qty): ApiResponse&amp;lt;ReservationToken&amp;gt;&lt;br/&gt;+ releaseStock(medId, qty): ApiResponse&amp;lt;Void&amp;gt;&lt;br/&gt;+ consumePhysical(allocs): ApiResponse&amp;lt;Void&amp;gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="200" width="380" x="460" y="480" as="geometry" />
        </mxCell>
        <mxCell id="notificationService" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;verticalAlign=top;align=center;fontSize=11;spacingTop=6;spacingLeft=6;spacingRight=6;spacingBottom=6;" value="&lt;i&gt;«service»&lt;/i&gt;&lt;br/&gt;&lt;b&gt;NotificationService&lt;/b&gt;&lt;hr style=&quot;margin:4px 0;border:0;border-top:1px solid #b85450;&quot;/&gt;&lt;div style=&quot;text-align:left;&quot;&gt;+ sendNotification(body): ApiResponse&amp;lt;Notification&amp;gt;&lt;br/&gt;+ listForPatient(patientId): ApiResponse&amp;lt;List&amp;lt;Notification&amp;gt;&amp;gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="100" width="380" x="880" y="480" as="geometry" />
        </mxCell>
        <mxCell id="identityService" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;align=center;fontSize=11;spacingTop=6;spacingLeft=6;spacingRight=6;spacingBottom=6;" value="&lt;i&gt;«service»&lt;/i&gt;&lt;br/&gt;&lt;b&gt;IdentityService&lt;/b&gt;&lt;hr style=&quot;margin:4px 0;border:0;border-top:1px solid #6c8ebf;&quot;/&gt;&lt;div style=&quot;text-align:left;&quot;&gt;+ login(req: LoginRequest): ApiResponse&amp;lt;LoginResponse&amp;gt;&lt;br/&gt;+ logout(token: String): ApiResponse&amp;lt;Void&amp;gt;&lt;br/&gt;+ validateToken(token: String): ApiResponse&amp;lt;User&amp;gt;&lt;/div&gt;" vertex="1">
