        <mxCell id="medication" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8d4b5;strokeColor=#a86c1c;verticalAlign=top;align=center;fontSize=11;spacingTop=6;spacingLeft=6;spacingRight=6;spacingBottom=6;" value="&lt;b&gt;Medication&lt;/b&gt;&lt;hr style=&quot;margin:4px 0;border:0;border-top:1px solid #a86c1c;&quot;/&gt;&lt;div style=&quot;text-align:left;&quot;&gt;- id: String&lt;br/&gt;- code: String&lt;br/&gt;- description: String&lt;br/&gt;- manufacturer: String&lt;br/&gt;- type: String&lt;br/&gt;- components: String&lt;br/&gt;- content: String&lt;br/&gt;- packaging: String&lt;br/&gt;- minStock: Integer&lt;/div&gt;" vertex="1">
