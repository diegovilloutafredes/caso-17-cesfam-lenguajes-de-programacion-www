        <mxCell id="writeOff" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffeb3b;strokeColor=#fbc02d;verticalAlign=top;align=center;fontSize=11;spacingTop=6;spacingLeft=6;spacingRight=6;spacingBottom=6;" value="&lt;b&gt;WriteOff&lt;/b&gt;&lt;hr style=&quot;margin:4px 0;border:0;border-top:1px solid #fbc02d;&quot;/&gt;&lt;div style=&quot;text-align:left;&quot;&gt;- id: String&lt;br/&gt;- reason: WriteOffReason&lt;br/&gt;- quantity: Integer&lt;br/&gt;- status: WriteOffStatus&lt;br/&gt;- expiredAt: Date&lt;br/&gt;- discardDate: Date [0..1]&lt;/div&gt;" vertex="1">
