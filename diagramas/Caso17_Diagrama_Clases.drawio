        <mxCell id="prescription" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;align=center;fontSize=11;spacingTop=6;spacingLeft=6;spacingRight=6;spacingBottom=6;" value="&lt;b&gt;Prescription&lt;/b&gt;&lt;hr style=&quot;margin:4px 0;border:0;border-top:1px solid #9673a6;&quot;/&gt;&lt;div style=&quot;text-align:left;&quot;&gt;- id: String&lt;br/&gt;- emissionDate: Date&lt;br/&gt;- pickupDeadline: Date&lt;br/&gt;- treatmentType: TreatmentType&lt;br/&gt;- durationDays: Integer&lt;br/&gt;- status: PrescriptionStatus&lt;br/&gt;- nextScheduledDelivery: Date&lt;/div&gt;&lt;hr style=&quot;margin:4px 0;border:0;border-top:1px solid #9673a6;&quot;/&gt;&lt;div style=&quot;text-align:left;&quot;&gt;+ changeStatus(s: PrescriptionStatus): void&lt;/div&gt;" vertex="1">
          <mxGeometry height="240" width="240" x="640" y="540" as="geometry" />
