<mxfile host="app.diagrams.net">
  <diagram id="case17" name="Caso 17 - Diagrama de Clases">
    <mxGraphModel dx="1067" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="2000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;" value="Caso 17 — CESFAM&lt;br&gt;Diagrama de Clases" vertex="1">
          <mxGeometry height="50" width="900" x="475" y="10" as="geometry" />
        </mxCell>
        <mxCell id="notaTransporte" parent="1" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=top;align=left;fontSize=11;spacingTop=8;spacingLeft=14;spacingRight=22;spacingBottom=8;shadow=1;" value="&lt;b&gt;Nota — Transporte vs Dominio&lt;/b&gt;&lt;hr style=&quot;margin: 6px 0px; border-width: 1px 0px 0px; border-style: solid none none; border-color: rgb(214, 182, 86) currentcolor currentcolor; border-image: initial;&quot;&gt;&lt;div style=&quot;text-align:left;&quot;&gt;Este diagrama modela el &lt;b&gt;dominio interno&lt;/b&gt; de cada servicio. Los métodos públicos retornan tipos de dominio directamente (Prescription, Batch, Patient, ...).&lt;br&gt;&lt;br&gt;En el &lt;b&gt;límite del servicio&lt;/b&gt; (capa de transporte / API REST), todos los métodos públicos se envuelven en:&lt;br&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&lt;i&gt;ApiResponse&amp;lt;T&amp;gt; { statusCode: Integer, data: T, error: ErrorDetail }&lt;/i&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="200" width="440" x="40" y="80" as="geometry" />
        </mxCell>
        <mxCell id="notaEnums" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;align=center;fontSize=10;spacingTop=6;spacingLeft=6;spacingRight=6;spacingBottom=6;dashed=1;" value="&lt;b&gt;Enumeraciones&lt;/b&gt;&lt;hr style=&quot;margin:4px 0;border:0;border-top:1px solid #666666;&quot;/&gt;&lt;div style=&quot;text-align:left;&quot;&gt;&lt;b&gt;UserRole:&lt;/b&gt; DOCTOR, PHARMACY_STAFF&lt;br/&gt;&lt;b&gt;PickerType:&lt;/b&gt; PATIENT, GUARDIAN, THIRD_PARTY&lt;br/&gt;&lt;b&gt;TreatmentType:&lt;/b&gt; SHORT, LONG&lt;br/&gt;&lt;b&gt;PrescriptionStatus:&lt;/b&gt; SUBMITTED, RESERVED,&lt;br/&gt;&amp;nbsp;&amp;nbsp;READY_FOR_PICKUP, PICKED_UP,&lt;br/&gt;&amp;nbsp;&amp;nbsp;EXTERNAL_PURCHASE, CANCELLED, EXPIRED&lt;br/&gt;&lt;b&gt;WriteOffStatus:&lt;/b&gt; DEDUCTED_FROM_AVAILABLE,&lt;br/&gt;&amp;nbsp;&amp;nbsp;DISCARDED&lt;br/&gt;&lt;b&gt;WriteOffReason:&lt;/b&gt; EXPIRATION, DAMAGED,&lt;br/&gt;&amp;nbsp;&amp;nbsp;BROKEN_PACKAGE, OTHER&lt;br/&gt;&lt;b&gt;NotificationType:&lt;/b&gt; SMS, EMAIL&lt;br/&gt;&lt;b&gt;DeliveryStatus:&lt;/b&gt; PENDING, SENT, ERROR&lt;br/&gt;&lt;b&gt;ReportType:&lt;/b&gt; STOCK, RESERVED, EXPIRED&lt;br/&gt;&lt;b&gt;NotificationEvent:&lt;/b&gt; STOCK_ARRIVED,&lt;br/&gt;&amp;nbsp;&amp;nbsp;RESERVATION_AVAILABLE, PICKUP_REMINDER&lt;hr style=&quot;margin:4px 0;border:0;border-top:1px solid #666666;&quot;/&gt;&lt;b&gt;Transiciones de PrescriptionStatus:&lt;/b&gt;&lt;br/&gt;SUBMITTED → RESERVED (sin stock)&lt;br/&gt;SUBMITTED → READY_FOR_PICKUP (con stock)&lt;br/&gt;RESERVED → READY_FOR_PICKUP (al llegar stock)&lt;br/&gt;READY_FOR_PICKUP → PICKED_UP (entrega)&lt;br/&gt;READY_FOR_PICKUP → EXPIRED (vence plazo)&lt;br/&gt;SUBMITTED → EXTERNAL_PURCHASE (sin stock + farmacia externa)&lt;br/&gt;* → CANCELLED (paciente desiste)&lt;/div&gt;" vertex="1">
          <mxGeometry height="340" width="480" x="1400" y="40" as="geometry" />
        </mxCell>
        <mxCell id="rolOpsNote" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;align=center;fontSize=10;spacingTop=6;spacingLeft=10;spacingRight=10;spacingBottom=6;dashed=1;" value="&lt;b&gt;Operaciones autorizadas por rol&lt;/b&gt;&lt;br/&gt;&lt;i&gt;(implementadas en services, no son métodos de User)&lt;/i&gt;&lt;hr style=&quot;margin:4px 0;border:0;border-top:1px solid #666666;&quot;/&gt;&lt;div style=&quot;text-align:left;&quot;&gt;&lt;b&gt;DOCTOR:&lt;/b&gt;&lt;br/&gt;+ createPrescription(): Prescription&lt;br/&gt;+ reviewStock(m: Medication): Stock&lt;br/&gt;&lt;br/&gt;&lt;b&gt;PHARMACY_STAFF:&lt;/b&gt;&lt;br/&gt;+ addStock(b: Batch): void&lt;br/&gt;+ registerDelivery(d: MedicationDelivery): void&lt;br/&gt;+ registerWriteOff(w: WriteOff): void&lt;br/&gt;+ reservePrescription(p: Prescription): void&lt;br/&gt;+ generateReport(): Report&lt;/div&gt;" vertex="1">
          <mxGeometry height="180" width="440" x="40" y="320" as="geometry" />
        </mxCell>
        <mxCell id="patient" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;align=center;fontSize=11;spacingTop=6;spacingLeft=6;spacingRight=6;spacingBottom=6;" value="&lt;b&gt;Patient&lt;/b&gt;&lt;hr style=&quot;margin:4px 0;border:0;border-top:1px solid #82b366;&quot;/&gt;&lt;div style=&quot;text-align:left;&quot;&gt;- id: String&lt;br/&gt;- rut: String&lt;br/&gt;- firstName: String&lt;br/&gt;- lastName: String&lt;br/&gt;- birthDate: Date&lt;br/&gt;- address: String&lt;br/&gt;- phone: String&lt;br/&gt;- email: String&lt;/div&gt;" vertex="1">
          <mxGeometry height="210" width="240" x="40" y="540" as="geometry" />
        </mxCell>
        <mxCell id="user" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;align=center;fontSize=11;spacingTop=6;spacingLeft=6;spacingRight=6;spacingBottom=6;" value="&lt;b&gt;User&lt;/b&gt;&lt;hr style=&quot;margin: 4px 0px; border-width: 1px 0px 0px; border-style: solid none none; border-color: rgb(108, 142, 191) currentcolor currentcolor; border-image: initial;&quot;&gt;&lt;div style=&quot;text-align:left;&quot;&gt;- id: String&lt;br&gt;- username: String&lt;br&gt;- rut: String&lt;br&gt;- fullName: String&lt;br&gt;- email: String&lt;br&gt;- role: UserRole&lt;/div&gt;&lt;hr style=&quot;margin: 4px 0px; border-width: 1px 0px 0px; border-style: solid none none; border-color: rgb(108, 142, 191) currentcolor currentcolor; border-image: initial;&quot;&gt;&lt;div style=&quot;text-align:left;&quot;&gt;+ authenticate(password: String): Boolean&lt;br&gt;+ logOut(): void&lt;/div&gt;" vertex="1">
          <mxGeometry height="220" width="240" x="320" y="540" as="geometry" />
