        <mxCell id="title" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;" value="Caso 17 — CESFAM&lt;br&gt;Diagrama de Clases — Backend Monolito Modular (Entrega 3)" vertex="1">
