        <mxCell id="t_users" parent="db_box" style="shape=ext;double=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;ghost=0;" value="&lt;b&gt;users&lt;/b&gt;&lt;hr/&gt;• id (PK) [VARCHAR] &quot;USR-001&quot;&lt;br/&gt;• username [VARCHAR] (unique)&lt;br&gt;• passwordHash [VARCHAR]&lt;br/&gt;• rut [VARCHAR]&lt;br/&gt;• fullName [VARCHAR]&lt;br/&gt;• email [VARCHAR] (nullable)&lt;br/&gt;• role [VARCHAR]" vertex="1">
          <mxGeometry height="170" width="230" x="170" y="20" as="geometry" />
        </mxCell>

        <mxCell id="cyl_patient" parent="db_box" style="shape=cylinder;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#d5e8d4;strokeColor=#82b366;align=center;fontStyle=1;fontSize=11;verticalAlign=top;spacingTop=6;" value="patient_db&#xa;(PostgreSQL)" vertex="1">
