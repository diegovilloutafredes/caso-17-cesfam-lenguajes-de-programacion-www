        <mxCell id="ms_identity" parent="ms_box" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;fontSize=10;fontColor=#000000;spacingLeft=6;spacingTop=4;" value="&lt;b&gt;IdentityService&lt;/b&gt; (:8001)&lt;hr/&gt;+ login(req) · logout(token)&lt;br/&gt;+ validateToken(token)" vertex="1">
