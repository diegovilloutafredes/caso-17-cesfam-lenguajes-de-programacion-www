        <mxCell id="cyl_identity" parent="db_box" style="shape=cylinder;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=center;fontStyle=1;fontSize=11;verticalAlign=top;spacingTop=6;" value="identity_db&#xa;(PostgreSQL)" vertex="1">
