        </mxCell>
        <mxCell id="t_patients" parent="db_box" style="shape=ext;double=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;ghost=0;" value="&lt;b&gt;patients&lt;/b&gt;&lt;hr/&gt;• id (PK) [VARCHAR] &quot;PAT-001&quot;&lt;br/&gt;• rut [VARCHAR]&lt;br/&gt;• firstName [VARCHAR]&lt;br/&gt;• lastName [VARCHAR]&lt;br/&gt;• birthDate [DATE] (nullable)&lt;br/&gt;• address [VARCHAR] (nullable)&lt;br/&gt;• phone [VARCHAR] (nullable)&lt;br/&gt;• email [VARCHAR] (nullable)&lt;br/&gt;• patientCardNumber [VARCHAR] (nullable)&lt;br/&gt;• patientCardIssueDate [DATE] (nullable)" vertex="1">
          <mxGeometry height="215" width="250" x="170" y="195" as="geometry" />
        </mxCell>
        <mxCell id="t_guardians" parent="db_box" style="shape=ext;double=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;ghost=0;" value="&lt;b&gt;guardians&lt;/b&gt;&lt;hr/&gt;• id (PK) [VARCHAR] &quot;GRD-001&quot;&lt;br/&gt;• patientId (FK → patients.id) [VARCHAR]&lt;br/&gt;• rut [VARCHAR]&lt;br/&gt;• firstName [VARCHAR]&lt;br/&gt;• lastName [VARCHAR]&lt;br/&gt;• phone [VARCHAR] (nullable)&lt;br/&gt;• email [VARCHAR] (nullable)&lt;br/&gt;• relationship [VARCHAR]&lt;br/&gt;• authorizationDate [DATE] (nullable)" vertex="1">
          <mxGeometry height="200" width="270" x="450" y="195" as="geometry" />
        </mxCell>

        <mxCell id="cyl_inventory" parent="db_box" style="shape=cylinder;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=center;fontStyle=1;fontSize=11;verticalAlign=top;spacingTop=6;" value="inventory_db&#xa;(PostgreSQL)" vertex="1">
          <mxGeometry height="100" width="110" x="30" y="470" as="geometry" />
        </mxCell>
        <mxCell id="t_medications" parent="db_box" style="shape=ext;double=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;ghost=0;" value="&lt;b&gt;medications&lt;/b&gt;&lt;hr/&gt;• id (PK) [VARCHAR] &quot;MED-0001&quot;&lt;br/&gt;• code [VARCHAR]&lt;br/&gt;• description [VARCHAR]&lt;br/&gt;• manufacturer [VARCHAR]&lt;br/&gt;• type [VARCHAR]&lt;br/&gt;• components [VARCHAR]&lt;br/&gt;• content [VARCHAR]&lt;br/&gt;• packaging [VARCHAR]&lt;br/&gt;• minStock [INT]&lt;br/&gt;• availableQuantity [INT]&lt;br/&gt;• reservedQuantity [INT]&lt;br&gt;• isolatedQuantity [INT]&lt;br/&gt;• physicalQuantity [INT]" vertex="1">
          <mxGeometry height="260" width="250" x="170" y="430" as="geometry" />
        </mxCell>
        <mxCell id="t_batches" parent="db_box" style="shape=ext;double=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;ghost=0;" value="&lt;b&gt;batches&lt;/b&gt;&lt;hr/&gt;• id (PK) [VARCHAR] &quot;BCH-001&quot;&lt;br/&gt;• medicationId (FK → medications.id) [VARCHAR]&lt;br/&gt;• batchNumber [VARCHAR]&lt;br/&gt;• arrivalDate [DATE]&lt;br/&gt;• expirationDate [DATE]&lt;br/&gt;• initialQuantity [INT]&lt;br/&gt;• availableQuantity [INT]" vertex="1">
          <mxGeometry height="165" width="270" x="450" y="430" as="geometry" />
        </mxCell>
        <mxCell id="t_write_offs" parent="db_box" style="shape=ext;double=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;ghost=0;" value="&lt;b&gt;write_offs&lt;/b&gt;&lt;hr/&gt;• id (PK) [VARCHAR] &quot;WOF-001&quot;&lt;br/&gt;• batchId (FK → batches.id) [VARCHAR]&lt;br/&gt;• medicationId [VARCHAR] (copia local)&lt;br/&gt;• staffId [VARCHAR] · ID externo · HTTP&lt;br/&gt;• reason [VARCHAR]&lt;br/&gt;• quantity [INT]&lt;br/&gt;• status [VARCHAR]&lt;br/&gt;• expiredAt [VARCHAR]&lt;br/&gt;• discardDate [VARCHAR] (nullable)&lt;br/&gt;• notes [VARCHAR] (nullable)" vertex="1">
          <mxGeometry height="215" width="270" x="450" y="620" as="geometry" />
        </mxCell>

        <mxCell id="cyl_prescription" parent="db_box" style="shape=cylinder;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#f8cecc;strokeColor=#b85450;align=center;fontStyle=1;fontSize=11;verticalAlign=top;spacingTop=6;" value="prescription_db&#xa;(PostgreSQL)" vertex="1">
          <mxGeometry height="100" width="110" x="740" y="40" as="geometry" />
        </mxCell>
        <mxCell id="t_prescriptions" parent="db_box" style="shape=ext;double=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;ghost=0;" value="&lt;b&gt;prescriptions&lt;/b&gt;&lt;hr/&gt;• id (PK) [VARCHAR] &quot;R001&quot;&lt;br/&gt;• doctorId [VARCHAR] · ID externo · HTTP&lt;br/&gt;• patientId [VARCHAR] · ID externo · HTTP&lt;br/&gt;• emissionDate [DATE]&lt;br/&gt;• pickupDeadline [DATE]&lt;br/&gt;• treatmentType [VARCHAR]&lt;br/&gt;• durationDays [INT]&lt;br/&gt;• status [VARCHAR]&lt;br/&gt;• nextScheduledDelivery [DATE] (nullable)&lt;br&gt;• reminderSentAt [DATE] (nullable)&lt;br/&gt;• externalPurchaseNotes [VARCHAR] (nullable)&lt;br/&gt;• cancelReason [VARCHAR] (nullable)&lt;br/&gt;• delivery [JSONB] (nullable)" vertex="1">
          <mxGeometry height="280" width="290" x="880" y="20" as="geometry" />
        </mxCell>
        <mxCell id="t_prescription_items" parent="db_box" style="shape=ext;double=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;ghost=0;" value="&lt;b&gt;prescription_items&lt;/b&gt;&lt;hr/&gt;• id (PK) [INT] autoincrement&lt;br/&gt;• prescriptionId (FK → prescriptions.id) [VARCHAR]&lt;br/&gt;• medicationId [VARCHAR] · ID externo · HTTP&lt;br/&gt;• dosesPerInterval [INT]&lt;br/&gt;• intervalHours [INT]&lt;br/&gt;• doseDescription [VARCHAR]&lt;br/&gt;• durationDays [INT]&lt;br/&gt;• totalQuantity [INT]" vertex="1">
          <mxGeometry height="180" width="290" x="880" y="310" as="geometry" />
        </mxCell>

        <mxCell id="cyl_notification" parent="db_box" style="shape=cylinder;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#fff2cc;strokeColor=#d6b656;align=center;fontStyle=1;fontSize=11;verticalAlign=top;spacingTop=6;" value="notification_db&#xa;(PostgreSQL)" vertex="1">
          <mxGeometry height="100" width="110" x="740" y="540" as="geometry" />
        </mxCell>
        <mxCell id="t_notifications" parent="db_box" style="shape=ext;double=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;ghost=0;" value="&lt;b&gt;notifications&lt;/b&gt;&lt;hr/&gt;• id (PK) [VARCHAR] &quot;NTF-001&quot;&lt;br/&gt;• type [VARCHAR] (SMS | EMAIL)&lt;br/&gt;• event [VARCHAR]&lt;br/&gt;• recipientPatientId [VARCHAR] (nullable) · ID externo · HTTP&lt;br/&gt;• recipientGuardianId [VARCHAR] (nullable) · ID externo · HTTP&lt;br/&gt;• recipientAddress [VARCHAR]&lt;br/&gt;• message [VARCHAR]&lt;br/&gt;• sentAt [TIMESTAMP] (nullable)&lt;br/&gt;• status [VARCHAR] (PENDING | SENT | ERROR)&lt;br/&gt;• prescriptionId [VARCHAR] (nullable) · ID externo · HTTP" vertex="1">
          <mxGeometry height="225" width="290" x="880" y="510" as="geometry" />
        </mxCell>

        <mxCell id="note_box" parent="db_box" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;fontSize=10;spacingLeft=10;spacingTop=8;spacingRight=10;" value="&lt;b&gt;Database per Service:&lt;/b&gt; cada microservicio es dueño de su propia base PostgreSQL. Las referencias entre contextos son IDs resueltos por HTTP (clientes con Circuit Breaker + Retry), nunca por JOIN. Corrige el patrón Shared DB del diseño original por el principio canónico de microservicios.&#xa;&#xa;• NO existe una base compartida: identity_db · patient_db · inventory_db · prescription_db · notification_db son bases físicamente separadas (ver db-init/01-create-databases.sql).&#xa;• Las FK reales (en gris &quot;FK →&quot;) solo cruzan tablas DENTRO de la misma base. Los campos marcados &quot;ID externo · HTTP&quot; (p. ej. prescriptions.patientId, notifications.recipientPatientId, write_offs.staffId) referencian otro contexto y se resuelven vía HTTP, no por JOIN.&#xa;• ReportService y ApiGateway NO persisten: no tienen base; agregan datos llamando a los servicios por HTTP." vertex="1">
          <mxGeometry height="140" width="1140" x="30" y="850" as="geometry" />
        </mxCell>

        <mxCell id="e_front_gw" edge="1" parent="1" source="react_app" style="endArrow=classic;html=1;rounded=1;fontSize=10;edgeStyle=orthogonalEdgeStyle;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="api_gateway" value="HTTPS&#xa;JSON / REST">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

