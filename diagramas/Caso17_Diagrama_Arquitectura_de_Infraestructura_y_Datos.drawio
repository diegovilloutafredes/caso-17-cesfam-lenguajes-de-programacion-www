        <mxCell id="e_gw_ms_inv" edge="1" parent="1" source="api_gateway" style="endArrow=classic;html=1;rounded=1;fontSize=10;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="ms_inventory" value="HTTP" />
        <mxCell id="e_gw_ms_pre" edge="1" parent="1" source="api_gateway" style="endArrow=classic;html=1;rounded=1;fontSize=10;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.68;entryX=0;entryY=0.5;" target="ms_prescription" value="HTTP" />
