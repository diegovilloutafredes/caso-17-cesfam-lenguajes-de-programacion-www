        <mxCell id="e_gw_ms_rep" edge="1" parent="1" source="api_gateway" style="endArrow=classic;html=1;rounded=1;fontSize=10;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.95;entryX=0;entryY=0.5;" target="ms_report" value="HTTP" />

        <mxCell id="e_id_db" edge="1" parent="1" source="ms_identity" style="endArrow=classic;html=1;rounded=1;fontSize=10;edgeStyle=orthogonalEdgeStyle;strokeColor=#9673a6;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="cyl_identity" value="SQL (propia)" />
        <mxCell id="e_pat_db" edge="1" parent="1" source="ms_patient" style="endArrow=classic;html=1;rounded=1;fontSize=10;edgeStyle=orthogonalEdgeStyle;strokeColor=#82b366;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="cyl_patient" value="SQL (propia)" />
        <mxCell id="e_inv_db" edge="1" parent="1" source="ms_inventory" style="endArrow=classic;html=1;rounded=1;fontSize=10;edgeStyle=orthogonalEdgeStyle;strokeColor=#d79b00;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="cyl_inventory" value="SQL (propia)" />
        <mxCell id="e_pre_db" edge="1" parent="1" source="ms_prescription" style="endArrow=classic;html=1;rounded=1;fontSize=10;edgeStyle=orthogonalEdgeStyle;strokeColor=#b85450;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="cyl_prescription" value="SQL (propia)" />
        <mxCell id="e_not_db" edge="1" parent="1" source="ms_notification" style="endArrow=classic;html=1;rounded=1;fontSize=10;edgeStyle=orthogonalEdgeStyle;strokeColor=#d6b656;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="cyl_notification" value="SQL (propia)" />
