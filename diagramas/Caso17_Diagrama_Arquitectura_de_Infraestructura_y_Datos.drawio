        <mxCell id="ms_patient" parent="ms_box" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;fontSize=9;fontColor=#000000;spacingLeft=6;spacingTop=2;" value="&lt;b&gt;PatientService&lt;/b&gt; (:8002)&lt;hr/&gt;+ getPatient(id) · listPatients(filter) · updatePatient(id)&lt;br/&gt;+ getHistory(id) · addGuardian(pId) · listGuardians(pId)" vertex="1">
